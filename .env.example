## Copy to .env and fill in secrets (DO NOT COMMIT .env)

# Hugging Face token (optional; used for downloading local models)
HF_TOKEN=

# OpenAI (optional; used by generate_words.py --llm and openai TTS provider)
OPENAI_API_KEY=

# Local open-weight models (disabled by default; enabling downloads model weights)
MMS_TTS_ENABLED=0
# MMS_TTS_DEVICE=cpu

OUTETTS_ENABLED=0
# OUTETTS_BACKEND=hf
# OUTETTS_SPEAKERS=EN-FEMALE-1-NEUTRAL

# Optional: restrict providers run by render_audio.py
# PERSIAN_VOICE_PROVIDERS=openai
