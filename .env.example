## Copy to .env and fill in secrets (DO NOT COMMIT .env)

# Hugging Face token (optional; used for downloading local models)
HF_TOKEN=

# OpenAI (optional; used by generate_words.py --llm and openai TTS provider)
OPENAI_API_KEY=

# Local open-weight models (disabled by default; enabling downloads model weights)
MMS_TTS_ENABLED=0
# MMS_TTS_DEVICE=cpu

# OuteTTS 1B: supports replicate (cloud), hf (local), or llamacpp (local GGUF) backends
# Backend auto-detection: uses Replicate if token set, else local if OUTETTS_ENABLED=1
# OUTETTS_BACKEND=replicate
OUTETTS_ENABLED=0
# OUTETTS_SPEAKERS=EN-FEMALE-1-NEUTRAL
# OUTETTS_TEMPERATURE=0.4

# Replicate API token (required for OuteTTS cloud backend and future Replicate providers)
REPLICATE_API_TOKEN=

# Optional: restrict providers run by render_audio.py
# PERSIAN_VOICE_PROVIDERS=openai
